mport java.util.*;
class Node{
    int data;
    Node addr;
    Node(int val){
        this.data=val;
        this.addr=null;
    }
}
class Queue{
    Node front,rear;
    Queue(){
        front=rear=null;
    }
    void enqueue(int val){
        Node newNode=new Node(val);
        if(rear==null){
            front=rear=newNode;
        }
        else{
            rear.addr=newNode;
            rear=newNode;
        }
    }
    void dequeue(){
        if(front==null){
            System.out.println("Queue is empty");
            return;
        }
        System.out.println(front.data);
        front=front.addr;
        if(front==null){
            rear=null;
        }
    }
    void display(){
        if(front==null){
            System.out.println("Queue is empty");
        }
        Node temp=front;
        while(temp!=null){
            System.out.println(temp.data+" ");
            temp=temp.addr;
        }
    }
}
    public class Main{
        public static void main(String[] args){
            Scanner sc=new Scanner(System.in);
            Queue q=new Queue();
            int val;
            do{
                val=sc.nextInt();
                if(val!=-1){
                    q.enqueue(val);
                }
            }
                while(val!=-1);
                q.dequeue();
                q.display();
    }
}
